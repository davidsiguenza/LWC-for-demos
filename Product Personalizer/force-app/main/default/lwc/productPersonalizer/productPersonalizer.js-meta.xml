<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Product Personalizer</masterLabel>
    <description>Adds a personalization modal (text + icon) to the PDP for products with IsCustomizable__c = true.</description>
    <targets>
        <target>lightningCommunity__Default</target>
        <target>lightningCommunity__Page</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="productId"
                type="String"
                label="Product ID (deprecated)"
                description="No longer used — product is now read from commerce/productApi context."
                default=""
            />
            <property
                name="buttonLabel"
                type="String"
                label="Button label"
                default="Personalizar tu producto"
            />
            <property
                name="primaryColor"
                type="String"
                label="Primary color (hex)"
                default="#002F6C"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
